# Copy to .env.local for local development.
# Get a Gemini key: https://aistudio.google.com/apikey

# --- Google AI Studio (recommended for OmaGBT) ---
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini

# Use live AI without Supabase (optional)
NEXT_PUBLIC_DEMO_MODE=false

# --- OpenAI-compatible alternative ---
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openai

# --- Supabase (optional cloud storage) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Parent PIN (optional server default) ---
# PARENT_PIN=
