# Copy to .env.local for local development.
# Get a Gemini key: https://aistudio.google.com/apikey
# Never commit real keys. Only NEXT_PUBLIC_* values reach the browser.

# --- Google AI Studio / Gemini (recommended for OmaGBT) ---
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=          # optional alias for the same Gemini key
AI_MODEL=gemini-3.6-flash
AI_PROVIDER=auto
# auto = Gemini if a Gemini key is set, else OpenAI if AI_API_KEY is set, else mock.

# --- OpenAI-compatible alternative ---
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openai

# --- Convex cloud memory ---
# `npx convex dev` writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL into .env.local.
# CONVEX_DEPLOYMENT is for the Convex CLI (for example `dev:oma-gbt` or `prod:oma-gbt`).
# NEXT_PUBLIC_CONVEX_URL is the deployment URL, for example https://<name>.convex.cloud.
# On Vercel, `npx convex deploy --cmd 'npm run build'` injects NEXT_PUBLIC_CONVEX_URL
# during the build. Set it explicitly as well so runtime matches the deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Production/preview deploys. Create in the Convex dashboard (Project → Settings → Deploy keys).
# Not required for local `npx convex dev`.
# CONVEX_DEPLOY_KEY=
# Server-only secret shared by the Next.js server and the Convex deployment.
# Generate with: openssl rand -hex 32
# Set the SAME value in the Convex dashboard: npx convex env set OMAGBT_HOUSEHOLD_SECRET <value>
# The oma-gbt Vercel project already has this variable — reuse that value in Convex.
OMAGBT_HOUSEHOLD_SECRET=

# --- Parent PIN (optional server default) ---
# PARENT_PIN=
