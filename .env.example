# ============================================================================
# OmaGBT environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in values.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ============================================================================

# --- AI provider (OpenAI-compatible) --------------------------------------
# Server-only. When AI_API_KEY is set, real streaming AI replaces the mock.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# --- Supabase cloud memory -------------------------------------------------
# Public (browser) values used by the Next.js server to call RPCs:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only household secret for omagbt_load / omagbt_save / omagbt_wipe.
# Generate with: openssl rand -hex 32
# Store the SHA-256 hex of this value in public.household_auth.secret_hash.
OMAGBT_HOUSEHOLD_SECRET=
# Optional. Not required when using the household-secret RPCs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Parent PIN (optional server default) ----------------------------------
PARENT_PIN=
