# Copy to .env.local for local development.
# Get a Gemini key: https://aistudio.google.com/apikey
# Never commit real keys. Only NEXT_PUBLIC_* values reach the browser.

# --- Google AI Studio / Gemini (recommended for OmaGBT) ---
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=          # optional alias for the same Gemini key
AI_MODEL=gemini-3.7-flash
AI_PROVIDER=auto
# auto = Gemini if a Gemini key is set, else OpenAI if AI_API_KEY is set, else mock.

# Use live Gemini without Supabase (optional)
NEXT_PUBLIC_DEMO_MODE=false

# --- OpenAI-compatible alternative ---
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openai

# --- Supabase (optional cloud storage) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Parent PIN (optional server default) ---
# PARENT_PIN=
