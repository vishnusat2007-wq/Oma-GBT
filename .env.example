# ============================================================================
# OmaGBT environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local`. Never commit real keys.
# Only NEXT_PUBLIC_* values reach the browser.
# ============================================================================

# --- Google AI Studio / Gemini (recommended) ---
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=          # optional alias for the same Gemini key
AI_MODEL=gemini-3.6-flash
AI_PROVIDER=auto
# auto = Gemini if a Gemini key is set, else OpenAI if AI_API_KEY is set, else mock.

# --- OpenAI-compatible alternative ---
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openai

# --- Supabase cloud memory ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only household secret for omagbt_load / omagbt_save / omagbt_wipe.
# Generate with: openssl rand -hex 32
# Store the SHA-256 hex of this value in public.household_auth.secret_hash.
OMAGBT_HOUSEHOLD_SECRET=
# Optional. Not required when using the household-secret RPCs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Parent PIN (optional server default) ---
PARENT_PIN=
